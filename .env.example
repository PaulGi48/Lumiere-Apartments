# Server-only database connection. Use Supabase's pooled connection string.
DATABASE_URL=

# At least 32 random characters; never expose this to the browser.
SESSION_SECRET=

# Public Supabase client configuration. These are safe to expose to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://lumiere-apartments.vercel.app

# Optional: keep low for serverless connection pooling.
PG_POOL_MAX=1
